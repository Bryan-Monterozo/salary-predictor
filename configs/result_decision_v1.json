    "min_calibration_records": 100,
    "min_calibration_empirical_coverage": "0.80",
    "model_range_basis": "calibrated_model_interval",
    "benchmark_range_basis": "published_source_range",
    "default_range_policy": "no_range",
    "allow_synthetic_percentage_bands": false
  },
  "reliability": {
    "suppress_small_groups_below": 30,
    "only_reveal_source_reported_support": true,
    "source_comparability_required": true,
    "source_age_warning_months": 24
  }
